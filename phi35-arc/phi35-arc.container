[Unit]
Description=Phi-3.5 Mini SYCL Server (Intel Arc GPU)
Requires=podman.socket

[Service]
Restart=always
TimeoutStartSec=900
ExecStartPre=-hf download bartowski/Phi-3.5-mini-instruct-GGUF Phi-3.5-mini-instruct-Q4_K_M.gguf --local-dir %h/.cache/huggingface/models

[Container]
ContainerName=phi35-arc
Image=ghcr.io/ggml-org/llama.cpp:server-intel
AddDevice=/dev/dri:/dev/dri
Environment=SYCL_PI_LEVEL_ZERO_USE_IMMEDIATE_COMMANDLISTS=1
Environment=ZES_ENABLE_SYSMAN=1
Volume=%h/.cache/huggingface/models:/models:z
PublishPort=8081:8080
Exec=--model /models/Phi-3.5-mini-instruct.Q4_K_M.gguf -fa on -ngl 99 --host 0.0.0.0 --port 8080

[Install]
WantedBy=multi-user.target default.target
