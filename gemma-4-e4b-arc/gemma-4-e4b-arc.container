[Unit]
Description=Gemma-4-E4B SYCL Server (Intel Arc GPU)
Requires=podman.socket

[Service]
Restart=always
TimeoutStartSec=900
ExecStartPre=-hf download unsloth/google_gemma-4-E4B-it-GGUF google_gemma-4-E4B-it-Q4_K_M.gguf --local-dir %h/.cache/huggingface/models

[Container]
ContainerName=gemma4-e4b-arc
Image=ghcr.io/ggml-org/llama.cpp:server-intel
AddDevice=/dev/dri:/dev/dri
Environment=SYCL_PI_LEVEL_ZERO_USE_IMMEDIATE_COMMANDLISTS=1
Environment=ZES_ENABLE_SYSMAN=1
Volume=%h/.cache/huggingface/models:/models:z
PublishPort=8080:8080
Exec=--model /models/google_gemma-4-E4B-it-Q4_K_M.gguf -fa on -ngl 99 --host 0.0.0.0 --port 8080

[Install]
WantedBy=multi-user.target default.target
